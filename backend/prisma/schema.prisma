generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  name           String
  phone          String?
  role           String          @default("CLIENT") // CLIENT or ADMIN
  userType       String          @default("REGULAR") // REGULAR or PREFERENT
  tokenVersion   Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  dogs           Dog[]
  stockMovements StockMovement[]
}

model Dog {
  id                       String    @id @default(uuid())
  userId                   String
  name                     String
  breed                    String
  age                      Int
  weight                   Float
  size                     String    @default("MEDIUM") // SMALL, MEDIUM, LARGE
  color                    String?
  sex                      String?   // MALE, FEMALE
  sterilized               Boolean   @default(false)
  character                String?
  specialRequirements      String?
  foodType                 String?
  foodQuantity             String?
  foodAdditionalIndication String?
  notes                    String?
  vaccinationInfo          String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings                 Booking[]

  @@index([userId])
}

model Booking {
  id         String   @id @default(uuid())
  dogId      String
  type       String // HOTEL or DAYCARE
  checkIn    DateTime
  checkOut   DateTime
  totalPrice Float // TODO: migrate to Decimal for production-grade currency precision
  status     String   @default("CONFIRMED") // CONFIRMED or CANCELLED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  dog        Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([dogId, status, checkIn, checkOut])
}

model HotelRate {
  id            String   @id @default(uuid())
  type          String   @unique // REGULAR, HOLIDAY, LONG_WEEKEND, VACATION
  pricePerNight Float // TODO: migrate to Decimal for production-grade currency precision
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DaycareRate {
  id          String   @id @default(uuid())
  pricePerDay Float // TODO: migrate to Decimal for production-grade currency precision
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SpecialPeriod {
  id        String   @id @default(uuid())
  name      String
  type      String // HOLIDAY, LONG_WEEKEND, VACATION
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate, endDate])
}

model Capacity {
  id          String   @id @default(uuid())
  type        String   @unique // HOTEL or DAYCARE
  maxCapacity Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RevokedToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model InventoryItem {
  id                String          @id @default(uuid())
  sku               String          @unique
  name              String
  description       String?
  category          String          // PET_ACCESSORIES, PET_FOOD, VETERINARY
  unitOfMeasure     String
  costPrice         Float
  sellingPrice      Float
  currentStock      Int             @default(0)
  lowStockThreshold Int             @default(10)
  expiryDate        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  movements         StockMovement[]

  @@index([category])
  @@index([deletedAt])
}

model StockMovement {
  id            String        @id @default(uuid())
  itemId        String
  type          String        // RECEIVE or DEDUCT
  quantity      Int
  note          String?
  performedById String
  createdAt     DateTime      @default(now())
  item          InventoryItem @relation(fields: [itemId], references: [id])
  performedBy   User          @relation(fields: [performedById], references: [id])

  @@index([itemId, createdAt])
}
