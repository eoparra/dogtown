# Database Configuration
# For local development with Docker:
# DATABASE_URL="postgresql://dogtown:password@localhost:5432/dogtown_dev"

# For production (Railway, Render, etc.):
# DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

DATABASE_URL="postgresql://dogtown:password@localhost:5432/dogtown_dev"

# JWT Secret — REQUIRED. The server will refuse to start without this.
# Generate a strong secret for production:
#   openssl rand -base64 32
# Never use the placeholder value below in a real deployment.
JWT_SECRET="REPLACE_ME_WITH_OUTPUT_OF_openssl_rand_-base64_32"

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Settings (frontend URL)
# For local development:
CORS_ORIGIN="http://localhost:5173"
# For production (supports multiple origins, comma-separated):
# CORS_ORIGIN="https://dogtown.up.railway.app"
