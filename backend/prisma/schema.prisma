generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  name           String
  phone          String?
  role           String          @default("CLIENT") // CLIENT or ADMIN
  userType       String          @default("REGULAR") // REGULAR or PREFERENT
  tokenVersion   Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  dogs           Dog[]
  stockMovements StockMovement[]
  sales          Sale[]
}

model Dog {
  id                       String    @id @default(uuid())
  userId                   String
  name                     String
  breed                    String
  age                      Int
  weight                   Float
  size                     String    @default("MEDIUM") // SMALL, MEDIUM, LARGE
  color                    String?
  sex                      String?   // MALE, FEMALE
  sterilized               Boolean   @default(false)
  character                String?
  specialRequirements      String?
  foodType                 String?
  foodQuantity             String?
  foodAdditionalIndication String?
  notes                    String?
  vaccinationInfo          String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings                 Booking[]
  packBalances             DogPackBalance[]
  daycareVisits            DaycareVisit[]

  @@index([userId])
}

model Booking {
  id         String   @id @default(uuid())
  dogId      String
  type       String // HOTEL or DAYCARE
  checkIn    DateTime
  checkOut   DateTime
  totalPrice Float // TODO: migrate to Decimal for production-grade currency precision
  status     String   @default("CONFIRMED") // CONFIRMED or CANCELLED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  dog        Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([dogId, status, checkIn, checkOut])
}

model HotelRate {
  id            String   @id @default(uuid())
  type          String   @unique // REGULAR, HOLIDAY, LONG_WEEKEND, VACATION
  pricePerNight Float // TODO: migrate to Decimal for production-grade currency precision
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DaycareRate {
  id          String   @id @default(uuid())
  pricePerDay Float // TODO: migrate to Decimal for production-grade currency precision
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SpecialPeriod {
  id        String   @id @default(uuid())
  name      String
  type      String // HOLIDAY, LONG_WEEKEND, VACATION
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate, endDate])
}

model Capacity {
  id          String   @id @default(uuid())
  type        String   @unique // HOTEL or DAYCARE
  maxCapacity Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RevokedToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model InventoryItem {
  id                String          @id @default(uuid())
  sku               String          @unique
  name              String
  description       String?
  category          String          // PET_ACCESSORIES, PET_FOOD, VETERINARY
  unitOfMeasure     String
  costPrice         Float
  sellingPrice      Float
  currentStock      Int             @default(0)
  lowStockThreshold Int             @default(10)
  expiryDate        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  movements         StockMovement[]

  @@index([category])
  @@index([deletedAt])
}

model StockMovement {
  id            String        @id @default(uuid())
  itemId        String
  type          String        // RECEIVE or DEDUCT
  quantity      Int
  note          String?
  performedById String
  createdAt     DateTime      @default(now())
  item          InventoryItem @relation(fields: [itemId], references: [id])
  performedBy   User          @relation(fields: [performedById], references: [id])

  @@index([itemId, createdAt])
}

model Service {
  id          String      @id @default(uuid())
  name        String
  description String?
  pricingType PricingType @default(FIXED)
  price       Float?
  priceSmall  Float?
  priceMedium Float?
  priceLarge  Float?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum PricingType {
  FIXED
  BY_SIZE
}

enum PackType {
  DAYCARE_DAYS
  HOTEL_NIGHTS
}

model DogPackBalance {
  id             String   @id @default(uuid())
  dogId          String
  packType       PackType
  remainingUnits Int      @default(0)
  dog            Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([dogId, packType])
  @@index([dogId])
}

model ServicePack {
  id            String   @id @default(uuid())
  name          String
  description   String?
  packType      PackType
  unitsIncluded Int
  priceSmall    Float
  priceMedium   Float
  priceLarge    Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

model Sale {
  id            String        @id @default(uuid())
  clientId      String?
  clientName    String
  clientPhone   String?
  paymentMethod PaymentMethod
  status        String        @default("COMPLETED")
  total         Float
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  client        User?         @relation(fields: [clientId], references: [id])
  lineItems     SaleLineItem[]

  @@index([clientId])
  @@index([createdAt])
}

model SaleLineItem {
  id         String  @id @default(uuid())
  saleId     String
  sourceType String  // PRODUCT | SERVICE
  sourceId   String
  itemName   String
  unitPrice  Float
  quantity   Int     @default(1)
  dogId      String?
  dogName    String?
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model DaycareVisit {
  id           String    @id @default(uuid())
  dogId        String
  checkInAt    DateTime  @default(now())
  checkOutAt   DateTime?
  cancelledAt  DateTime?
  dog          Dog       @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([dogId])
}
